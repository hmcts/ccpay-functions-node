#!groovy
//noinspection GroovyUnusedAssignment
@Library("Infrastructure")
import uk.gov.hmcts.contino.azure.Acr

def product = "ccpay"
def component = "callback-function"

def ftNamespace = "fees-pay"
def ftRelease = "ccpay-callback-function-ft"
def ftTopic = "ccpay-service-callback-ft-topic"
def ftSubscription = "serviceCallbackFunctionalTestSubscription"
def ftBusSecret = "ccpay-callback-function-premium-sb"

def ftBranch() {
    def slug = (env.BRANCH_NAME ?: '').toLowerCase().replaceAll('[^a-z0-9]+', '-').replaceAll(/^-|-$/, '')
    return slug ?: 'unknown'
}

def ftReleaseFull() {
    // Same per-branch naming as the CNP pipeline so builds never clobber each other
    return "${ftRelease}-${ftBranch()}"
}

def ftJob() {
    return "${ftReleaseFull()}-functional-test"
}

def loginToAatAks() {
    sh "az aks get-credentials --resource-group ${env.AAT_AKS_RESOURCE_GROUP ?: 'cft-aat-00-rg'} " +
       "--name ${env.AAT_AKS_CLUSTER_NAME ?: 'cft-aat-00-aks'} " +
       "--subscription ${env.AKS_AAT_SUBSCRIPTION_NAME ?: 'DCD-CFTAPPS-STG'} " +
       "-a --overwrite-existing"
}

def registry() {
    return 'hmctsprod.azurecr.io'
}

def loginToAcr() {
    // The library's acr login does `az login --identity` + sets AZURE_CONFIG_DIR and then
    // `az acr login`. A bare `az acr login` fails because no identity context is active yet.
    def subscription = env.NONPROD_SUBSCRIPTION_NAME ?: 'nonprod'
    localAcrLogin(subscription)
}

def localAcrLogin(String subscription) {
    withAcrClient(subscription) {
        def acr = new Acr(this, subscription, env.REGISTRY_NAME, env.REGISTRY_RESOURCE_GROUP, env.REGISTRY_SUBSCRIPTION)
        acr.login()
    }
}

def shortSha() {
    return sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
}

def imageTag(String branch) {
    return "${branch.toLowerCase()}-${shortSha()}"
}

def buildImages() {
    def tag = imageTag(env.BRANCH_NAME)
    loginToAcr()

    sh "docker build -t ${registry()}/ccpay/${component}:${tag} ."
    sh "docker push ${registry()}/ccpay/${component}:${tag}"

    sh "docker build -t ${registry()}/ccpay/callback-function-rig:${tag} rig"
    sh "docker push ${registry()}/ccpay/callback-function-rig:${tag}"

    sh "docker build -t ${registry()}/ccpay/callback-function-functional-test:${tag} functional-test"
    sh "docker push ${registry()}/ccpay/callback-function-functional-test:${tag}"
}

def runFunctionalTest() {
    def branch = env.BRANCH_NAME
    def release = ftReleaseFull()
    sh "helm upgrade --install ${release} charts/ccpay-callback-function -n ${ftNamespace} --create-namespace " +
       "--set global.environment=aat " +
       "--set global.enableKeyVaults=true " +
       "--set function.image=${registry()}/ccpay/${component}:${imageTag(branch)} " +
       "--set 'function.environment.SERVICE_CALLBACK_TOPIC_NAME=${ftTopic}' " +
       "--set 'function.environment.SERVICE_CALLBACK_SUBSCRIPTION=${ftSubscription}' " +
       "--set 'function.triggers[0].topicName=${ftTopic}' " +
       "--set 'function.triggers[0].subscriptionName=${ftSubscription}' " +
       "--set 'function.environment.SERVICE_CALLBACK_URL_PATTERN=^http://${release}-rig(:[0-9]+)?(/.*)?\$' " +
       "--set 'function.secrets.SERVICE_CALLBACK_BUS_CONNECTION.secretRef=${ftBusSecret}' " +
       "--set 'function.secrets.SERVICE_CALLBACK_BUS_CONNECTION.key=SERVICE_CALLBACK_BUS_CONNECTION' " +
       "--set rig.enabled=true --set rig.image=${registry()}/ccpay/callback-function-rig:${imageTag(branch)} " +
       "--set functional-test.enabled=true --set functional-test.image=${registry()}/ccpay/callback-function-functional-test:${imageTag(branch)}"
}

def waitForFunctionalTest() {
    sh "kubectl -n ${ftNamespace} wait --for=condition=complete job/${ftJob()} --timeout=240s"
}

def collectAndPublishFunctionalTestReport() {
    def job = ftJob()
    try {
        sh "mkdir -p functional-output/functional/allure"
        def pod = sh(script: "kubectl -n ${ftNamespace} get pods -l app=${job} --field-selector=status.phase=Succeeded -o jsonpath='{.items[0].metadata.name}'", returnStdout: true).trim()
        if (!pod) {
            echo 'No functional-test pod found to retrieve a report from'
        } else {
            sh "kubectl -n ${ftNamespace} cp ${pod}:/tmp/report/index.html functional-output/functional/allure/index.html"
            sh "kubectl -n ${ftNamespace} cp ${pod}:/tmp/report/junit.xml functional-output/junit.xml"
        }
    } catch (err) {
        echo "Could not retrieve functional-test report: ${err}"
    }

    if (fileExists('functional-output/junit.xml')) {
        junit 'functional-output/junit.xml'
    }
    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : 'functional-output/functional/allure',
        reportFiles          : 'index.html',
        reportName           : 'Callback function functional tests result'
    ]
}

def teardownFunctionalTest() {
    sh "helm uninstall ${ftReleaseFull()} -n ${ftNamespace}"
}

withNightlyPipeline("nodejs", product, component) {
    after('checkout') {
        // Nightly runs against the current source so the fresh image exercises the latest code.
        buildImages()
    }

    after('test') {
        echo 'Running callback-function functional tests against the real Service Bus'
        // Serialise on the shared AAT FT topic/subscription with the CNP pipeline.
        lock("${product}-${component}-functional-test") {
            try {
                loginToAatAks()
                runFunctionalTest()
                waitForFunctionalTest()
            } finally {
                try {
                    loginToAatAks()
                } catch (err) {
                    echo "AAT login failed during teardown: ${err}"
                }
                collectAndPublishFunctionalTestReport()
                teardownFunctionalTest()
            }
        }
    }
}