#!groovy
//noinspection GroovyUnusedAssignment
@Library("Infrastructure")
import groovy.transform.Field

@Field def product = "ccpay"
@Field def component = "callback-function"

@Field def ftNamespace = "fees-pay"
@Field def ftRelease = "ccpay-callback-function-ft"
@Field def ftTopic = "ccpay-service-callback-ft-topic"
@Field def ftSubscription = "serviceCallbackFunctionalTestSubscription"
@Field def ftBusSecret = "ccpay-callback-function-premium-sb"

def ftBranch() {
    def slug = (env.BRANCH_NAME ?: '').toLowerCase().replaceAll('[^a-z0-9]+', '-').replaceAll(/^-|-$/, '')
    return slug ?: 'unknown'
}

def ftReleaseFull() {
    // Same per-branch naming as the CNP pipeline so builds never clobber each other
    return "${ftRelease}-${ftBranch()}"
}

def ftJob() {
    return "${ftReleaseFull()}-functional-test"
}

def loginToAatAks() {
    def subscription = env.NONPROD_SUBSCRIPTION_NAME ?: 'nonprod'
    withSubscriptionLogin(subscription) {
        sh "env AZURE_CONFIG_DIR=/opt/jenkins/.azure-${subscription} az aks get-credentials " +
           "--resource-group ${env.AAT_AKS_RESOURCE_GROUP ?: 'cft-aat-01-rg'} " +
           "--name ${env.AAT_AKS_CLUSTER_NAME ?: 'cft-aat-01-aks'} " +
           "--subscription ${env.AKS_AAT_SUBSCRIPTION_NAME ?: 'DCD-CNP-DEV'} " +
           "-a --overwrite-existing"
    }
}

def registry() {
    return 'hmctsprod.azurecr.io'
}

def loginToAcr() {
    // Replicates the library's Acr.login() without instantiating Acr (which fails to compile when
    // imported directly into the Jenkinsfile). withAcrClient runs `az login --identity` and loads
    // registry secrets, then az acr login targets the defined registry/subscription.
    def subscription = env.NONPROD_SUBSCRIPTION_NAME ?: 'nonprod'
    withAcrClient(subscription) {
        sh "env AZURE_CONFIG_DIR=/opt/jenkins/.azure-${subscription} az acr login " +
           "--name ${env.REGISTRY_NAME} --subscription ${env.REGISTRY_SUBSCRIPTION}"
    }
}

def helmPrepare() {
    // Mirror the library's Helm setup: authenticate to the ACR so Helm can pull the OCI chart
    // dependencies (function/servicebus) and fetch them into charts/ before install.
    def subscription = env.NONPROD_SUBSCRIPTION_NAME ?: 'nonprod'
    withAcrClient(subscription) {
        sh "env AZURE_CONFIG_DIR=/opt/jenkins/.azure-${subscription} az acr login " +
           "--name ${env.REGISTRY_NAME} --subscription ${env.REGISTRY_SUBSCRIPTION}"
    }
    sh "helm dependency update charts/ccpay-callback-function"
}

def shortSha() {
    return sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
}

def imageTag(String branch) {
    return "${branch.toLowerCase()}-${shortSha()}"
}

def buildImages() {
    def tag = imageTag(env.BRANCH_NAME)
    loginToAcr()

    sh "docker build -t ${registry()}/ccpay/${component}:${tag} ."
    sh "docker push ${registry()}/ccpay/${component}:${tag}"

    sh "docker build -t ${registry()}/ccpay/callback-function-rig:${tag} rig"
    sh "docker push ${registry()}/ccpay/callback-function-rig:${tag}"

    sh "docker build -t ${registry()}/ccpay/callback-function-functional-test:${tag} functional-test"
    sh "docker push ${registry()}/ccpay/callback-function-functional-test:${tag}"
}

def runFunctionalTest() {
    def branch = env.BRANCH_NAME
    def release = ftReleaseFull()
    helmPrepare()
    sh "helm upgrade --install ${release} charts/ccpay-callback-function -n ${ftNamespace} --create-namespace " +
       "--set global.environment=aat " +
       "--set global.enableKeyVaults=true " +
       "-f charts/ccpay-callback-function/values.ft.yaml " +
       "--set function.image=${registry()}/ccpay/${component}:${imageTag(branch)} " +
       "--set 'function.environment.SERVICE_CALLBACK_URL_PATTERN=^http://${release}-rig(:[0-9]+)?(/.*)?\$' " +
       "--set 'function.secrets.SERVICE_CALLBACK_BUS_CONNECTION.secretRef=${ftBusSecret}' " +
       "--set 'function.secrets.SERVICE_CALLBACK_BUS_CONNECTION.key=SERVICE_CALLBACK_BUS_CONNECTION' " +
       "--set rig.image=${registry()}/ccpay/callback-function-rig:${imageTag(branch)} " +
       "--set functional-test.image=${registry()}/ccpay/callback-function-functional-test:${imageTag(branch)}"
}

def waitForFunctionalTest() {
    def job = ftJob()
    def timeout = 240
    def deadline = new Date().time + timeout * 1000
    while (new Date().time < deadline) {
        def state = sh(script: "kubectl -n ${ftNamespace} get job ${job} -o jsonpath='{.status.succeeded}:{.status.failed}'", returnStdout: true).trim()
        echo "Functional test job ${job} status (succeeded:failed): ${state}"
        def parts = state.split(':')
        def succeeded = (parts.size() > 0 && parts[0]) ? parts[0].toInteger() : 0
        def failed = (parts.size() > 1 && parts[1]) ? parts[1].toInteger() : 0
        if (succeeded >= 1) {
            echo "Functional test job ${job} completed"
            return
        }
        if (failed >= 1) {
            echo "Functional test job ${job} failed"
            return
        }
        sleep 10
    }
    error "Functional test job ${job} did not reach a terminal state within ${timeout}s"
}

def collectAndPublishFunctionalTestReport() {
    def job = ftJob()
    try {
        sh "mkdir -p functional-output/functional/allure"
        // The harness emits the report files base64-encoded to stdout, so select the latest pod
        // regardless of phase and decode from the logs (kubectl cp cannot exec into a completed
        // pod, and Groovy decodeBase64 is forbidden by the sandbox).
        def pod = sh(script: "kubectl -n ${ftNamespace} get pods -l app=${job} -o jsonpath='{.items[-1].metadata.name}'", returnStdout: true).trim()
        if (!pod || pod == '[]') {
            echo 'No functional-test pod found to retrieve a report from'
        } else {
            sh "kubectl -n ${ftNamespace} logs ${pod} --tail=500 || true"
            sh """kubectl -n ${ftNamespace} logs ${pod} | sed -n '/FUNCTIONAL_REPORT_HTML_B64_START/,/FUNCTIONAL_REPORT_HTML_B64_END/p' | sed '1d;\$d' | base64 -d > functional-output/functional/allure/index.html || true"""
            sh """kubectl -n ${ftNamespace} logs ${pod} | sed -n '/FUNCTIONAL_REPORT_JUNIT_B64_START/,/FUNCTIONAL_REPORT_JUNIT_B64_END/p' | sed '1d;\$d' | base64 -d > functional-output/junit.xml || true"""
        }
    } catch (err) {
        echo "Could not retrieve functional-test report: ${err}"
    }

    if (fileExists('functional-output/junit.xml')) {
        junit 'functional-output/junit.xml'
    }
    publishHTML target: [
        allowMissing         : true,
        alwaysLinkToLastBuild: true,
        keepAll              : true,
        reportDir            : 'functional-output/functional/allure',
        reportFiles          : 'index.html',
        reportName           : 'Callback function functional tests result'
    ]
}

def teardownFunctionalTest() {
    sh "helm uninstall ${ftReleaseFull()} -n ${ftNamespace}"
}

withNightlyPipeline("nodejs", product, component) {
    after('checkout') {
        // Nightly runs against the current source so the fresh image exercises the latest code.
        buildImages()
    }

    after('test') {
        echo 'Running callback-function functional tests against the real Service Bus'
        // Serialise on the shared AAT FT topic/subscription with the CNP pipeline.
        lock("${product}-${component}-functional-test") {
            try {
                loginToAatAks()
                runFunctionalTest()
                waitForFunctionalTest()
            } finally {
                try {
                    loginToAatAks()
                } catch (err) {
                    echo "AAT login failed during teardown: ${err}"
                }
                collectAndPublishFunctionalTestReport()
                teardownFunctionalTest()
            }
        }
    }
}